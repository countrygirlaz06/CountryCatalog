
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Country Catalog</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/styles.css">
</head>

<body>

    <nav class="navbar navbar-dark bg-dark">
        <div class="container">
            <span class="navbar-brand">Country Catalog</span>
            <a href="/logout" class="btn btn-outline-light">Logout</a>
        </div>
    </nav>

    <div class="container mt-5">

        <h1>Country Catalog</h1>
        <p class="text-muted">View and manage your saved countries.</p>

        <div class="table-responsive">
            <table class="table table-striped table-bordered">
                <thead class="table-dark">
                    <tr>
                        <th>ID</th>
                        <th>Country</th>
                        <th>Popular Site</th>
                        <th>Capital</th>
                        <th>Population</th>
                        <th>Visited</th>
                        <th>Actions</th>
                    </tr>
                </thead>

                <tbody>
                    <% countries.forEach(country => { %>
                        <tr>
                            <td><%= country.country_id %></td>
                            <td><%= country.country_name %></td>
                            <td><%= country.popular_site %></td>
                            <td><%= country.capital %></td>
                            <td><%= country.population.toLocaleString() %></td>
                            <td><%= country.visited || 'N/A' %></td>
                            <td>
                                <a href="/countries/edit/<%= country.country_id %>"
                                    class="btn btn-sm btn-primary">Edit</a>
                                <form action="/countries/delete/<%= country.country_id %>"
                                    method="POST"
                                    style="display: inline;"
                                    onsubmit="return confirm('Are you sure you want to delete this country?');">

                                    <button type="submit" class="btn btn-sm btn-danger">
                                        Delete
                                    </button>

                                </form>
                                <a href="/countries/map/<%= country.country_id %>"
                                   class="btn btn-sm btn-success">Map</a>
                            </td>
                        </tr>
                    <% }); %>
                </tbody>
            </table>
        </div>
        <div class="text-end mt-3">
            <a href="/countries/add" class="btn btn-success">
                + Add Country
            </a>
        </div>

    </div>

</body>
</html>
