
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Country Map</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css">

    <link rel="stylesheet" href="/css/styles.css">

    <style>
        #map {
            height: 500px;
            width: 100%;
            border-radius: 10px;
        }
    </style>
</head>

<body>

    <nav class="navbar navbar-dark bg-dark">
        <div class="container">
            <a href="/countries" class="navbar-brand">Country Catalog</a>
            <a href="/logout" class="btn btn-outline-light">Logout</a>
        </div>
    </nav>

    <div class="container mt-5">

        <h1><%= country.country_name %></h1>
        <p class="text-muted">
            Explore <%= country.country_name %> on the map.
        </p>

        <div id="map" data-country-name="<%= country.country_name %>"></div>

        <div class="mt-4">
            <a href="/countries" class="btn btn-secondary">
                Back to Countries
            </a>
        </div>

    </div>

    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

    <script>
        const countryName = document.getElementById('map').dataset.countryName;

        async function loadMap() {
            try {
                const response = await fetch(
                    'https://nominatim.openstreetmap.org/search?format=json&limit=1&q=' +
                    encodeURIComponent(countryName)
                );

                const locations = await response.json();

                if (locations.length === 0) {
                    document.getElementById('map').innerHTML =
                        'Location could not be found.';
                    return;
                }

                const latitude = Number(locations[0].lat);
                const longitude = Number(locations[0].lon);

                const map = L.map('map').setView(
                    [latitude, longitude], 5
                );

                L.tileLayer(
                    'https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png',
                    {
                        attribution: '&copy; OpenStreetMap contributors'
                    }
                ).addTo(map);

                L.marker([latitude, longitude])
                    .addTo(map)
                    .bindPopup(countryName)
                    .openPopup();

            } catch (error) {
                console.error(error);

                document.getElementById('map').innerHTML =
                    'Unable to load the map.';
            }
        }

        loadMap();
    </script>

</body>
</html>
