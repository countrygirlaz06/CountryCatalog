
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Country</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/styles.css">
</head>

<body>

    <nav class="navbar navbar-dark bg-dark">
        <div class="container">
            <a href="/countries" class="navbar-brand">Country Catalog</a>
            <a href="/logout" class="btn btn-outline-light">Logout</a>
        </div>
    </nav>

    <div class="container mt-5">

        <div class="row justify-content-center">
            <div class="col-md-7 col-lg-6">

                <h1>Edit Country</h1>
                <p class="text-muted">Update the country information below.</p>

                <% if (error) { %>
                    <div class="alert alert-danger"><%= error %></div>
                <% } %>

                <form action="/countries/edit/<%= country.country_id %>" method="POST">

                    <div class="mb-3">
                        <label for="country_name" class="form-label">Country Name</label>
                        <input type="text" class="form-control"
                            id="country_name" name="country_name"
                            maxlength="30" value="<%= country.country_name %>" required>
                    </div>

                    <div class="mb-3">
                        <label for="popular_site" class="form-label">Popular Site</label>
                        <input type="text" class="form-control"
                            id="popular_site" name="popular_site"
                            maxlength="50" value="<%= country.popular_site %>" required>
                    </div>

                    <div class="mb-3">
                        <label for="capital" class="form-label">Capital</label>
                        <input type="text" class="form-control"
                            id="capital" name="capital"
                            maxlength="30" value="<%= country.capital %>" required>
                    </div>

                    <div class="mb-3">
                        <label for="population" class="form-label">Population</label>
                        <input type="number" class="form-control"
                            id="population" name="population"
                            min="0" step="1" value="<%= country.population %>" required>
                    </div>

                    <div class="mb-3">
                        <label for="visited" class="form-label">Visited?</label>
                        <select class="form-select" id="visited" name="visited">
                            <option value="" <%= !country.visited ? 'selected' : '' %>>Not specified</option>
                            <option value="Y" <%= country.visited === 'Y' ? 'selected' : '' %>>Yes</option>
                            <option value="N" <%= country.visited === 'N' ? 'selected' : '' %>>No</option>
                        </select>
                    </div>

                    <button type="submit" class="btn btn-primary">
                        Save Changes
                    </button>

                    <a href="/countries" class="btn btn-secondary">
                        Cancel
                    </a>

                </form>

            </div>
        </div>

    </div>

</body>
</html>
